# Copy to .env.local and fill in. Never commit .env.local.
# The app runs with fallbacks when AI_PROVIDER=none or any optional key is missing.

# AI provider: gemini | anthropic | none
AI_PROVIDER=gemini

# Gemini (Google AI Studio free tier). Use current Flash / Flash-Lite model names from Google's docs.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Basemap tiles + geocoding. Without a key the map falls back to OpenFreeMap tiles.
NEXT_PUBLIC_MAPTILER_KEY=

# Road snapping and site context (public servers by default)
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional concept images
IMAGE_PROVIDER=
IMAGE_API_KEY=
